PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/encegen_db
JWT_SECRET=encegen_super_secret_admin_jwt_key_2026
ADMIN_EMAIL=admin@encegen.com
ADMIN_PASSWORD=admin123

# Website enquiry emails are delivered to this inbox.
CONTACT_EMAIL=contact@encegen.com
# Optional sender name/address; it should be permitted by your SMTP provider.
# CONTACT_FROM="Encegen Website" <your_smtp_username>

# SMTP config for website enquiries and job applications (fill in real values —
# e.g. a Gmail address + app password, or an SMTP relay like SendGrid/Mailgun).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Encegen Careers" <careers@encegen.com>
# Optional website enquiry sender; must be permitted by your SMTP provider.
# CONTACT_FROM="Encegen Website" <your_smtp_username>
